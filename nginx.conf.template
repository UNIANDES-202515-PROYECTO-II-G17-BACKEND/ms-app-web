# nginx.conf.template
server {
  listen ${PORT};
  server_name _;

  # Si tu build tiene /browser (Angular 17/18 con builder nuevo)
  root /usr/share/nginx/html/browser;
  index index.html index.csr.html;

  # (Opcional) si quieres mantener el redirect inicial:
  # Mejor redirige a /login/ (con slash) para no provocar el 301 siguiente.
  location = / { return 302 /login/; }

  # Assets con cache largo
  location ~* \.(?:js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
  }

  # Shell y env sin cache
  location = /index.html     { add_header Cache-Control "no-store"; }
  location = /index.csr.html { add_header Cache-Control "no-store"; }
  location = /assets/env.js  { add_header Cache-Control "no-store"; }

  # 🔧 CLAVE: primero intenta archivo tal cual, luego /index.html del directorio,
  # y por último cae al CSR (index.csr.html). Así evitas el 301 implícito.
  location / {
    try_files $uri $uri/index.html /index.csr.html;
  }

  # Salud
  location = /healthz { return 200 "ok"; }

  gzip on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
}
